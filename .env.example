# Public settings. Only NEXT_PUBLIC_* variables are exposed to the browser.
NEXT_PUBLIC_APP_NAME="国际局势简报"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-only persistence. Paste the pooled PostgreSQL connection string from Neon.
# Example format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=""
REDIS_URL="redis://localhost:6379"

# Server-only DeepSeek RAG Agent. The Agent only runs when the test button is pressed.
# Prefer DEEPSEEK_API_KEY; LLM_API_KEY is retained for compatibility.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash"
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-v4-flash"
AGENT_DIGEST_TTL_SECONDS="1800"

# Server-only news ingestion. The default uses multiple Chinese-language RSS feeds.
# Set NEWS_SOURCE_PROVIDER="un-news-rss" for only UN News, or "gdelt-doc" for GDELT DOC.
# These values are optional; defaults are applied when left blank.
NEWS_SOURCE_API_KEY=""
NEWS_SOURCE_PROVIDER="multi-rss-zh"
NEWS_SOURCE_QUERY=""
NEWS_SOURCE_TIMESPAN="24h"
NEWS_SOURCE_MAX_RECORDS="25"
NEWS_SOURCE_MAX_AGE_HOURS="72"

# Server-only full-web search contract. Leave WEB_SEARCH_PROVIDER blank until
# a provider adapter is enabled in the next implementation step.
# Runtime provider IDs: bocha, tavily. Other contract IDs (brave, serper,
# custom) are reserved until their adapters are added.
WEB_SEARCH_PROVIDER=""
WEB_SEARCH_API_KEY=""
WEB_SEARCH_BASE_URL=""
# disabled: no Agent requests; manual: only the test button (default);
# full: enables both the button and the daily Vercel Cron.
WEB_SEARCH_ROLLOUT="manual"
WEB_SEARCH_MAX_RESULTS="12"
WEB_SEARCH_MAX_AGE_HOURS="72"
# Optional comma-separated domain suffixes. When blank, all public HTTP(S)
# search results are eligible; excluded domains always take precedence.
WEB_SEARCH_ALLOWED_DOMAINS=""
WEB_SEARCH_EXCLUDED_DOMAINS=""

# Server-only security and observability settings.
CRON_SECRET=""
SESSION_SECRET=""
SENTRY_DSN=""
